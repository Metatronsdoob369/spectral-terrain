    {
      "parameters": {
        "jsCode": "let rawPayload = '';\nlet domain = 'source-audit';\n\nif (items[0] && items[0].json && items[0].json.body) {\n  rawPayload = JSON.stringify(items[0].json.body);\n  if (items[0].json.body.domain) {\n    domain = items[0].json.body.domain;\n  }\n} else if (items[0] && items[0].json) {\n  rawPayload = JSON.stringify(items[0].json);\n}\n\nreturn [{\n  json: {\n    payload: rawPayload,\n    domain: domain\n  }\n}];"
      },
